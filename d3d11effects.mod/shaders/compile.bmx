SuperStrict
Framework BRL.StandardIO
Import BRL.BankStream
Import BRL.FileSystem
?win32
Import Pub.Win32

Extern "win32"
Function FreeLibrary:Int(library:Byte Ptr) = "WINBOOL __stdcall FreeLibrary(HMODULE)!"
Interface ID3DCompilerBlob Extends IUnknown_
	Method GetBufferPointer:Byte Ptr()
	Method GetBufferSize:Size_T()
End Interface
End Extern

Function CompileEffect(sourcePath:String, entryName:String, output:TStream, index:Int)
	Local library:Byte Ptr=LoadLibraryA("d3dcompiler_47.dll")
	If Not library Then Throw "Cannot load d3dcompiler_47.dll"
	Local code:ID3DCompilerBlob, errors:ID3DCompilerBlob
	Try
		Local compile:Int(source:Byte Ptr, size:Size_T, name:Byte Ptr, defines:Byte Ptr, includes:Byte Ptr, entry:Byte Ptr, target:Byte Ptr, flags:UInt, flags2:UInt, code:ID3DCompilerBlob Var, errors:ID3DCompilerBlob Var) "win32" = GetProcAddress(library,"D3DCompile")
		If Not compile Then Throw "D3DCompile is unavailable"
		Local source:TBank=LoadBank(sourcePath)
		If Not source Then Throw "Cannot read: "+sourcePath
		Local name:Byte Ptr=sourcePath.ToUTF8String(), entry:Byte Ptr=entryName.ToCString(), target:Byte Ptr="ps_4_0".ToCString()
		Local result:Int
		Try
			result=compile(source.Buf(),Size_T(source.Size()),name,Null,Null,entry,target,$8000,0,code,errors)
		Finally
			MemFree(name); MemFree(entry); MemFree(target)
		End Try
		If errors Then Print String.FromUTF8String(errors.GetBufferPointer())
		If result<0 Or Not code Then Throw "D3DCompile failed: "+result
		Local bytes:Byte Ptr=code.GetBufferPointer()
		WriteShaderLine(output,"static const unsigned char effect"+index+"[]={")
		For Local i:Int=0 Until Int(code.GetBufferSize())
			output.WriteString(Int(bytes[i])+",")
			If i Mod 24=23 Then WriteShaderLine(output,"")
		Next
		WriteShaderLine(output,"~n};")
	Finally
		If errors Then errors.Release_()
		If code Then code.Release_()
		FreeLibrary(library)
	End Try
End Function
?

' Emit stable LF source on every host.
Function WriteShaderLine(output:TStream,value:String)
 output.WriteString(value+"~n")
End Function

ChangeDir(LaunchDir)

Try
	If AppArgs.Length<>3 Then Throw "Usage: compile_effects input.hlsl output.cpp"
?win32
	Local output:TStream=WriteFile(AppArgs[2])
	If Not output Then Throw "Cannot write output"
	Try
		WriteShaderLine(output,"// Generated by shaders/compile.bmx from shaders/effects.hlsl.~n#include <cstddef>")
		Local names:String[]=["saturation","colorize","blur","outline","bright","tone","linearOutput"]
		For Local i:Int=0 Until names.Length
			CompileEffect(AppArgs[1],names[i],output,i)
		Next
		WriteShaderLine(output,"extern ~qC~q const void *m2d11_builtin_effect(int kind,size_t *size) {~nswitch(kind) {")
		For Local i:Int=0 Until names.Length
			WriteShaderLine(output,"case "+i+": *size=sizeof(effect"+i+"); return effect"+i+";")
		Next
		WriteShaderLine(output,"default: *size=0; return nullptr;~n}~n}")
	Finally
		output.Close()
	End Try
?Not win32
	Throw "Shader compilation requires Windows and d3dcompiler_47.dll"
?
Catch error:Object
	Print "compile_effects: "+error.ToString()
	EndWithCode(1)
End Try
